{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@game/*": [
        "../../../games/slot-001/client/than/*"
      ],
      "@core/*": [
        "src/*"
      ],
      "pixi.js": [
        "node_modules/pixi.js"
      ],
      "@esotericsoftware/spine-pixi-v8": [
        "node_modules/@esotericsoftware/spine-pixi-v8"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "dev/**/*.ts",
    "tests/**/*.test.ts",
    "vite.config.ts",
    "../../../games/slot-001/client/than/*.ts"
  ]
}
